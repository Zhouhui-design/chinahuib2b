# ============================================
# Database Configuration
# ============================================
DATABASE_URL="postgresql://expo_user:CHANGE_THIS_PASSWORD@localhost:5432/x2xhub"

# ============================================
# Redis Configuration
# ============================================
REDIS_URL="redis://:CHANGE_THIS_REDIS_PASSWORD@localhost:6379"

# ============================================
# NextAuth Authentication
# ============================================
NEXTAUTH_URL="https://x2xhub.com"
NEXTAUTH_SECRET="GENERATE_WITH: openssl rand -base64 32"

# ============================================
# File Storage Configuration (Local Disk)
# ============================================
# Files are stored in public/uploads directory
# Accessible at: https://yourdomain.com/uploads/...
UPLOAD_DIR=/var/www/x2xhub/public/uploads

# ============================================
# DigitalOcean Spaces Storage (Optional - for future migration)
# ============================================
# When ready to migrate from local storage to Spaces:
# DO_SPACES_ENDPOINT="https://sgp1.digitaloceanspaces.com"
# DO_SPACES_BUCKET="x2xhub-storage"
# DO_SPACES_ACCESS_KEY="YOUR_SPACES_ACCESS_KEY_HERE"
# DO_SPACES_SECRET_KEY="YOUR_SPACES_SECRET_KEY_HERE"
# DO_SPACES_REGION="sgp1"

# ============================================
# Chat System WebSocket Configuration
# ============================================
NEXT_PUBLIC_CHAT_API_URL="https://x2xhub.com/api/chat"
NEXT_PUBLIC_CHAT_WS_URL="wss://x2xhub.com/ws"

# ============================================
# Sentry Error Monitoring
# ============================================
# Register at https://sentry.io/signup/ with sardenesy@gmail.com
NEXT_PUBLIC_SENTRY_DSN="https://YOUR_SENTRY_DSN_HERE"

# ============================================
# Other Configuration
# ============================================
NODE_ENV="production"
PORT="3000"
