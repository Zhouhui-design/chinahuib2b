enum TopicCategory {
  INDUSTRY
  HOT_TOPIC
  PRODUCT
  NEWS
  RECRUITMENT
  ARTICLE
  OTHER
}

model Topic {
  id                 String          @id @default(cuid())
  userId             String
  title              String
  content            String
  category           TopicCategory   @default(OTHER)
  images             String[]
  videos             String[]
  documents          Json?
  link               String?
  phone              String?
  keywords           String[]        @default([])
  viewCount          Int             @default(0)
  likeCount          Int             @default(0)
  commentCount       Int             @default(0)
  isActive           Boolean         @default(true)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  user               User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  comments           TopicComment[]
  likes              TopicLike[]

  @@index([userId])
  @@index([category])
  @@index([createdAt])
}

model TopicComment {
  id                 String          @id @default(cuid())
  topicId            String
  userId             String
  content            String
  parentId           String?
  likeCount          Int             @default(0)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  topic              Topic           @relation(fields: [topicId], references: [id], onDelete: Cascade)
  user               User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent             TopicComment?   @relation("TopicCommentParent", fields: [parentId], references: [id])
  replies            TopicComment[]  @relation("TopicCommentParent")
  likes              TopicLike[]

  @@index([topicId])
  @@index([userId])
  @@index([parentId])
}

model TopicLike {
  id                 String          @id @default(cuid())
  userId             String
  topicId            String?
  commentId          String?
  createdAt          DateTime        @default(now())
  user               User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic              Topic?          @relation(fields: [topicId], references: [id], onDelete: Cascade)
  comment            TopicComment?   @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([topicId])
  @@index([commentId])

  @@unique([userId, topicId], name: "TopicLike_userId_topicId_key")
  @@unique([userId, commentId], name: "TopicLike_userId_commentId_key")
}

