  portOfLoading         String?
  portOfDestination     String?
  incoterms             String?
  trackingNumber        String?
  carrierName           String?
  estimatedDeliveryDate DateTime?
  actualDeliveryDate    DateTime?
  buyerNote             String?
  sellerNote            String?
  platformFee           Decimal?             @db.Decimal(10, 2)
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  paidAt                DateTime?
  shippedAt             DateTime?
  deliveredAt           DateTime?
  cancelledAt           DateTime?
  completedAt           DateTime?
  buyer                 User                 @relation("OrderBuyer", fields: [buyerId], references: [id])
  seller                User                 @relation("OrderSeller", fields: [sellerId], references: [id])
  listing               AuctionListing       @relation(fields: [listingId], references: [id], onDelete: Cascade)
  escrow                EscrowTransaction?
  logisticsRecords      LogisticsRecord[]
  dispute               Dispute?

  @@index([buyerId])
  @@index([sellerId])
  @@index([listingId])
  @@index([status])
  @@index([paymentStatus])
  @@index([createdAt])
}

model EscrowTransaction {
  id                    String              @id @default(cuid())
  orderId               String              @unique
  buyerId               String
  sellerId              String
  amount                Decimal             @db.Decimal(10, 2)
  currency              String              @default("USD")
  status                EscrowStatus_Order  @default(PENDING)
  paymentMethod         PaymentMethod
  paymentGatewayTxId    String?
  releasedToSellerAt    DateTime?
  refundedToBuyerAt     DateTime?
  holdReason            String?
  autoReleaseDays       Int                 @default(7)
  releasedAt            DateTime?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  order                 Order               @relation(fields: [orderId], references: [id])
  buyer                 User                @relation("EscrowBuyer", fields: [buyerId], references: [id])
  seller                User                @relation("EscrowSeller", fields: [sellerId], references: [id])

  @@index([orderId])
  @@index([status])
  @@index([buyerId])
}

model LogisticsRecord {
  id              String        @id @default(cuid())
  orderId         String
  buyerId         String
  carrierName     String?
  trackingNumber  String?
  status          LogisticsStatus @default(PENDING_PICKUP)
  originPort      String?
  destinationPort String?
  estimatedArrival DateTime?
  actualArrival   DateTime?
  weight          Decimal?      @db.Decimal(10, 2)
  volume          Decimal?      @db.Decimal(10, 2)
  shippingDate    DateTime?
  deliveryDate    DateTime?
  documents       Json?
  notes           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  order           Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  buyer           User          @relation("LogisticsBuyer", fields: [buyerId], references: [id])
  updates         LogisticsUpdate_Order[]

  @@index([orderId])
  @@index([status])
  @@index([carrierName])
}

model LogisticsUpdate_Order {
  id            String        @id @default(cuid())
  logisticsId   String
  status        LogisticsStatus
  location      String?
  description   String?
  timestamp     DateTime      @default(now())
  createdAt     DateTime      @default(now())
  logistics     LogisticsRecord @relation(fields: [logisticsId], references: [id], onDelete: Cascade)

  @@index([logisticsId])
  @@index([status])
}

model Dispute {
  id            String         @id @default(cuid())
  orderId       String         @unique
  buyerId       String
  sellerId      String
  type          DisputeType
  status        DisputeStatus  @default(OPEN)
  reason        String
  resolution    String?
  resolutionAmount Decimal?   @db.Decimal(10, 2)
  resolutionCurrency String?   @default("USD")
  resolvedBy    String?
  resolvedAt    DateTime?
  buyerDocs     Json?
  sellerDocs    Json?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  order         Order          @relation(fields: [orderId], references: [id])
  buyer         User          @relation("DisputeBuyer", fields: [buyerId], references: [id])
  seller        User          @relation("DisputeSeller", fields: [sellerId], references: [id])

  @@index([orderId])
  @@index([status])
  @@index([type])
}
