generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// User accounts (buyers and sellers, humans and AI agents)
model User {
  id          String    @id @default(cuid())
  email       String    @unique
  username    String    @unique
  password    String
  role        UserRole  @default(BUYER)
  isActive    Boolean   @default(true)
  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Contact information for buyers
  displayName String? // Display name
  company     String? // Company name
  phone       String? // Phone number
  website     String? // Personal/Business website
  location    String? // City, Country
  bio         String? // Short bio/description
  avatarUrl   String? // Profile picture

  // AI Agent specific fields
  aiProvider     String? // OpenAI, Claude, Gemini, etc.
  aiModel        String? // GPT-4, Claude-3, etc.
  aiCapabilities Json? // What this AI can do
  isSystemAI     Boolean @default(false) // True for platform-owned AI
  isAI           Boolean @default(false) // True if this is an AI agent account
  ownerId        String? // The human user who owns this AI account
  owner          User?   @relation("AIOwner", fields: [ownerId], references: [id])
  aiAccounts     User[]  @relation("AIOwner")

  // New features for user vision
  dailyShoutOuts   Int       @default(10) // Daily shout out counter
  lastShoutOutDate DateTime? // Last shout out date
  isOnline         Boolean   @default(false) // Online status
  lastSeenAt       DateTime? // Last seen timestamp
  balance          Decimal?  @db.Decimal(10, 2) // User balance for paid features
  receiveNotices   Boolean   @default(true) // Whether to receive notices

  // Password reset
  resetToken       String?
  resetTokenExpiry DateTime?

  // Relations
  sellerProfile              SellerProfile?
  inquiries                  Inquiry[]
  brochuresDownloaded        BrochureDownload[]
  contactViews               ContactView[]
  paymentProofs              PaymentProof[]
  apiKeys                    APIKey[]
  apiUsageLogs               APIUsageLog[]
  marketplaceTasks           MarketplaceTask[]
  taskApplications           TaskApplication[]
  publicMessagesSent         PublicMessage[]             @relation("PublicMessagesSent")
  privateMessagesSent        PrivateMessage[]            @relation("PrivateMessagesSent")
  privateMessagesReceived    PrivateMessage[]            @relation("PrivateMessagesReceived")
  auctionListings            AuctionListing[]
  auctionBids               AuctionBid[]
  shoutOuts                  ShoutOut[]
  worldChatMessages          WorldChatMessage[]
  notices                    Notice[]
  boothViews                 BoothView[]
  digitalVoucherTransactions DigitalVoucherTransaction[]
  aiPermissions              AIPermission[]
  aiAuditLogs                AIAuditLog[]
  wallet                     Wallet?
  withdrawalRequests         WithdrawalRequest[]

  @@index([email])
  @@index([lastLoginAt])
  @@index([role])
  @@index([isOnline])
  @@index([dailyShoutOuts])
}

enum UserRole {
  BUYER
  SELLER
  ADMIN
  AI_BUYER // AI buyer agent
  AI_SELLER // AI seller agent
  AI_ASSISTANT // System AI assistant (platform-owned)
}

// Seller/Store profiles
model SellerProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  companyName    String
  companyType    CompanyType
  country        String
  city           String
  address        String?
  phone          String?
  email          String?
  website        String?
  whatsapp       String? // WhatsApp number
  wechat         String? // WeChat ID
  telegram       String? // Telegram username
  linkedin       String? // LinkedIn profile URL
  facebook       String? // Facebook page URL
  instagram      String? // Instagram profile
  description    String? // Rich text (stored as HTML) - deprecated, use descriptions instead
  descriptions   Json? // Multi-language descriptions { "zh": "...", "en": "...", "ja": "..." }
  logoUrl        String?
  bannerUrl      String?
  certifications String[] // Array of certification names

  // Booth customization - Enhanced for user vision
  boothName       String? // Custom exhibitor booth name (deprecated, use boothNames instead)
  boothNames      Json?   // Multi-language booth names { "zh": "...", "en": "...", "ja": "..." }
  boothCategories String[] // Product categories (multi-select)
  isCustomizable  Boolean  @default(false) // Whether products can be customized

  // Advanced Booth Customization
  boothTheme       String? // Light/Dark/Vibrant/etc
  boothLayout      String? // Layout type (modern/classic/grid)
  boothColor       String? // Primary color (hex)
  boothBgImage     String? // Background image URL
  boothAccentImage String? // Accent/decorative image
  boothFont        String? // Custom font choice
  boothAnimations  Boolean  @default(false) // Enable smooth animations
  booth3DPreview   Boolean  @default(false) // 3D booth preview
  boothTags        String[] // Tags for discoverability

  subscriptionStatus SubscriptionStatus @default(FREE_TRIAL)
  subscriptionExpiry DateTime?
  subscriptionAmount Decimal?           @db.Decimal(10, 2) // Amount paid in USD
  lastPaymentAt      DateTime?

  isVerified Boolean @default(false)
  isActive   Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  booths               Booth[]
  products             Product[]
  storeBrochures       StoreBrochure[]
  inquiries            Inquiry[]
  contactViews         ContactView[]
  paymentProofs        PaymentProof[]
  verificationFiles    SellerVerificationFile[]
  boothCustomizations  BoothCustomization[]
  boothViews           BoothView[]
  auctionListings      AuctionListing[]
  digitalVouchers      DigitalVoucher[]
  linkedPublicMessages PublicMessage[]          @relation("LinkedPublicMessages")

  @@index([companyName])
  @@index([country])
}

enum CompanyType {
  MANUFACTURER
  TRADER
  BOTH
}

enum SubscriptionStatus {
  FREE_TRIAL
  ACTIVE
  EXPIRED
  CANCELLED
}

// Product categories (3-level hierarchy)
model Category {
  id          String     @id @default(cuid())
  name        String
  nameEn      String?
  slug        String     @unique
  level       Int // 1, 2, or 3
  parentId    String?
  parent      Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryHierarchy")
  
  model       String?    // Model (型号)
  modelEn     String?    // Model (English)
  series      String?    // Series (系列)
  seriesEn    String?    // Series (English)
  description String?    // Description (分类描述)
  descriptionEn String?  // Description (English)

  products    Product[]

  @@index([slug])
  @@index([parentId])
}

// ========================================
// Exhibition Booth Models
// ========================================

model Booth {
  id          String        @id @default(cuid())
  sellerId    String
  seller      SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  
  name        String        // Booth name (e.g., "2024 Spring Fair")
  names       Json?         // Multi-language booth names
  
  // Exhibition info
  exhibitionName String     // Name of the exhibition/event
  exhibitionDates Json?     // {"start": "2024-03-01", "end": "2024-03-15"}
  location       String?    // Physical location or virtual
  
  // Booth status
  isActive     Boolean      @default(true)
  isPublished  Boolean      @default(false)
  
  // Booth customization (embedded for simplicity)
  theme        String?      // Light/Dark/Vibrant
  colorScheme  String?      // Primary color hex
  layout       String?      // modern/classic/grid
  
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  
  // Relations
  products    Product[]
  
  @@index([sellerId])
  @@index([isActive])
  @@index([isPublished])
}

// Products (exhibition items)
model Product {
  id       String        @id @default(cuid())
  sellerId String
  seller   SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  boothId  String?
  booth    Booth? @relation(fields: [boothId], references: [id])

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  title          String
  titleEn        String? // English title (deprecated, use titles instead)
  titles         Json?   // Multi-language titles { "zh": "...", "en": "...", "ja": "..." }
  description    String? // Rich text (deprecated, use descriptions instead)
  descriptions   Json?   // Multi-language descriptions { "zh": "...", "en": "...", "ja": "..." }
  specifications Json? // JSON object for specs

  minOrderQty    Int?
  supplyCapacity String?

  mainImageUrl String
  images       String[] // Array of image URLs

  hasBrochure Boolean @default(false)

  viewCount    Int @default(0)
  inquiryCount Int @default(0)

  isActive   Boolean @default(true)
  isFeatured Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  brochure  ProductBrochure?
  inquiries Inquiry[]

  @@index([sellerId])
  @@index([boothId])
  @@index([categoryId])
  @@index([isActive])
  @@index([createdAt])
}

// Product-level brochures
model ProductBrochure {
  id        String  @id @default(cuid())
  productId String  @unique
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  fileUrl       String
  fileName      String
  fileSize      Int // in bytes
  downloadCount Int    @default(0)

  uploadedAt DateTime @default(now())

  @@index([productId])
}

// Store-level brochures
model StoreBrochure {
  id       String        @id @default(cuid())
  sellerId String
  seller   SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  title    String
  fileUrl  String
  fileName String
  fileSize Int

  sortOrder     Int @default(0)
  downloadCount Int @default(0)

  createdAt DateTime @default(now())

  @@index([sellerId])
}

// Brochure download tracking
model BrochureDownload {
  id     String  @id @default(cuid())
  userId String? // Nullable for guest downloads
  user   User?   @relation(fields: [userId], references: [id])

  brochureType BrochureType
  brochureId   String // productId or storeBrochureId

  downloadedAt DateTime @default(now())
  ipAddress    String?

  @@index([userId])
  @@index([downloadedAt])
}

enum BrochureType {
  PRODUCT
  STORE
}

// Inquiries (traditional form-based)
model Inquiry {
  id      String @id @default(cuid())
  buyerId String
  buyer   User   @relation(fields: [buyerId], references: [id])

  sellerId String
  seller   SellerProfile @relation(fields: [sellerId], references: [id])

  productId String?
  product   Product? @relation(fields: [productId], references: [id])

  message     String
  contactInfo String // Buyer's contact info

  status InquiryStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sellerId])
  @@index([buyerId])
  @@index([status])
}

enum InquiryStatus {
  PENDING
  REPLIED
  CLOSED
}

// Contact view tracking (business card collection)
model ContactView {
  id       String @id @default(cuid())
  viewerId String
  viewer   User   @relation(fields: [viewerId], references: [id])

  sellerId String
  seller   SellerProfile @relation(fields: [sellerId], references: [id])

  viewedAt DateTime @default(now())

  @@unique([viewerId, sellerId])
  @@index([sellerId])
}

// Payment proof submission
model PaymentProof {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  sellerProfileId String?
  sellerProfile   SellerProfile? @relation(fields: [sellerProfileId], references: [id])

  amount        Decimal @db.Decimal(10, 2)
  currency      String  @default("USD")
  transactionId String?
  paymentMethod String  @default("ALIPAY")
  screenshotUrl String?
  notes         String?

  status     PaymentStatus @default(PENDING)
  adminNotes String?

  submittedAt DateTime  @default(now())
  reviewedAt  DateTime?

  @@index([userId])
  @@index([status])
  @@index([submittedAt])
}

enum PaymentStatus {
  PENDING
  APPROVED
  REJECTED
}

// Seller verification files (business license, ID, etc.)
model SellerVerificationFile {
  id       String        @id @default(cuid())
  sellerId String
  seller   SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  fileType VerificationFileType
  fileUrl  String
  fileName String
  fileSize Int // in bytes
  mimeType String? // e.g., image/jpeg, application/pdf

  isVerified Boolean   @default(false)
  verifiedAt DateTime?
  verifiedBy String? // Admin user ID who verified

  sortOrder   Int     @default(0)
  description String? // Optional description

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sellerId])
  @@index([fileType])
  @@index([isVerified])
}

enum VerificationFileType {
  BUSINESS_LICENSE // 营业执照
  ID_CARD // 身份证
  DRIVER_LICENSE // 驾驶证
  CREDIT_CARD // 信用卡（脱敏）
  PHOTO // 照片
  VIDEO // 视频
  OTHER // 其他
}

// SEO - TDK (Title/Description/Keywords) configuration
model SEOConfig {
  id       String @id @default(cuid())
  pagePath String @unique // e.g., "/", "/en", "/products/[id]"

  title         String? // Page title
  titleEn       String?
  description   String? // Meta description
  descriptionEn String?
  keywords      String? // Meta keywords (comma-separated)
  keywordsEn    String?

  // Page type for easier management
  pageType PageType @default(STATIC)

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([pageType])
  @@index([isActive])
}

enum PageType {
  STATIC // Static pages (home, about, etc.)
  PRODUCT // Product detail pages
  STORE // Store pages
  CATEGORY // Category pages
  CUSTOM // Custom pages
}

// Dead link tracking
model DeadLink {
  id  String @id @default(cuid())
  url String @unique

  sourceUrl  String? // Where the dead link was found
  statusCode Int // 404, 500, etc.

  isResolved Boolean   @default(false)
  resolvedAt DateTime?

  detectedAt    DateTime @default(now())
  lastCheckedAt DateTime @default(now())

  @@index([isResolved])
  @@index([detectedAt])
}

// API Keys for AI Agents
model APIKey {
  id          String    @id @default(cuid())
  userId      String
  key         String    @unique
  name        String    @default("AI Agent Key")
  role        String // buyer, seller, admin
  permissions Json      @default("{}")
  rateLimit   Int       @default(1000) // requests per hour
  isActive    Boolean   @default(true)
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  usageLogs APIUsageLog[]

  @@index([userId])
  @@index([key])
  @@index([isActive])
}

// API Usage Logs for audit trail
model APIUsageLog {
  id           String   @id @default(cuid())
  apiKeyId     String
  userId       String
  endpoint     String
  method       String
  statusCode   Int?
  responseTime Int? // milliseconds
  ipAddress    String?
  userAgent    String?
  metadata     Json?
  createdAt    DateTime @default(now())

  apiKey APIKey @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([apiKeyId])
  @@index([createdAt])
  @@index([endpoint])
}

// Marketplace Tasks (Task Hall)
model MarketplaceTask {
  id          String   @id @default(cuid())
  title       String
  description String
  type        TaskType

  // Pricing
  budget      Decimal? @db.Decimal(10, 2)
  price       Decimal? @db.Decimal(10, 2)
  currency    String   @default("USD")
  unit        String? // e.g., "per unit", "per hour"
  minOrderQty Int?

  // Timeline
  deadline DateTime?

  // Status
  status TaskStatus @default(OPEN)

  // Metadata
  postedById   String // User ID who posted the task
  postedBy     User     @relation(fields: [postedById], references: [id])
  contactInfo  String? // Contact email/phone
  applications Int      @default(0)
  views        Int      @default(0)
  rating       Decimal? @db.Decimal(3, 2) // For service providers

  // Attachments
  attachments Json? // Array of file URLs

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  taskApplications TaskApplication[]
  taskMilestones   TaskMilestone[]
  taskDeliverables TaskDeliverable[]
  taskEscrow       TaskEscrow?

  @@index([status])
  @@index([type])
  @@index([postedById])
  @@index([createdAt])
}

enum TaskType {
  MANUFACTURING // Looking for factory/manufacturer
  PRODUCT_SALE // Selling products
  SERVICE // Offering services
}

enum TaskStatus {
  OPEN // Accepting applications
  IN_PROGRESS // Negotiating or working
  COMPLETED // Task completed
  CANCELLED // Cancelled by poster
}

// Task Applications
model TaskApplication {
  id     String          @id @default(cuid())
  taskId String
  task   MarketplaceTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  applicantId  String // User ID who applied
  applicant    User     @relation(fields: [applicantId], references: [id])
  message      String // Application message
  quote        Decimal? @db.Decimal(10, 2) // Quoted price
  deliveryTime String? // Estimated delivery time

  status ApplicationStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([taskId])
  @@index([applicantId])
  @@index([status])
}

enum ApplicationStatus {
  PENDING // Awaiting review
  ACCEPTED // Application accepted
  REJECTED // Application rejected
  WITHDRAWN // Applicant withdrew
}

// Task Milestones - Milestone tracking for tasks
model TaskMilestone {
  id          String   @id @default(cuid())
  taskId      String
  task        MarketplaceTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  
  title       String
  description String?
  amount      Decimal @db.Decimal(10, 2) // Amount to be released when milestone is completed
  order       Int     // Order of milestone in sequence
  
  status      MilestoneStatus @default(PENDING)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([taskId])
  @@index([status])
}

enum MilestoneStatus {
  PENDING    // Milestone not yet reached
  COMPLETED  // Milestone completed, awaiting payment
  PAID       // Payment released
}

// Task Deliverables - Submitted deliverables for review
model TaskDeliverable {
  id           String   @id @default(cuid())
  taskId       String
  task         MarketplaceTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  
  title        String
  description  String?
  files        Json? // Array of file URLs
  
  submittedAt  DateTime?
  status       DeliverableStatus @default(DRAFT)
  reviewNotes  String? // Notes from reviewer
  
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  
  @@index([taskId])
  @@index([status])
}

enum DeliverableStatus {
  DRAFT     // Being worked on
  SUBMITTED // Submitted for review
  APPROVED  // Approved by task poster
  REJECTED  // Rejected, needs revision
}

// Task Escrow - Escrow service for task payments
model TaskEscrow {
  id           String       @id @default(cuid())
  taskId       String       @unique
  task         MarketplaceTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  
  // Amounts
  amount       Decimal      @db.Decimal(10, 2) // Total escrow amount
  currency     String       @default("USD")
  holdAmount   Decimal      @db.Decimal(10, 2) // Amount currently held
  releaseAmount Decimal     @db.Decimal(10, 2) // Amount released to provider
  
  // Status
  status       EscrowStatus @default(PENDING)
  transactionId String?
  
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  
  @@index([taskId])
  @@index([status])
}

enum EscrowStatus {
  PENDING    // Funds not deposited yet
  FUNDED     // Funds deposited
  RELEASING  // Partial release in progress
  COMPLETED  // All funds released
  DISPUTED   // Dispute initiated
  REFUNDED   // Funds refunded to poster
}

// ========================================
// AUCTION SYSTEM
// ========================================

// Auction Bid - Bids placed on auction listings
model AuctionBid {
  id          String           @id @default(cuid())
  listingId   String
  listing     AuctionListing   @relation(fields: [listingId], references: [id], onDelete: Cascade)

  bidderId    String
  bidder      User             @relation(fields: [bidderId], references: [id], onDelete: Cascade)
  
  // Bid details
  amount      Decimal          @db.Decimal(10, 2)
  currency    String           @default("USD")
  
  // Auto-bid settings
  isAutoBid   Boolean          @default(false)
  maxAutoBid  Decimal?         @db.Decimal(10, 2) // Maximum amount for auto-bid
  
  // Status
  status      AuctionBidStatus @default(PENDING)
  
  createdAt   DateTime         @default(now())
  
  @@index([listingId])
  @@index([bidderId])
  @@index([status])
  @@index([createdAt])
}

enum AuctionBidStatus {
  PENDING    // Bid placed, awaiting confirmation
  ACCEPTED   // Bid accepted as current highest
  OUTBID     // Outbid by another bidder
  CANCELLED  // Bid cancelled by bidder
  WON        // Won the auction
  LOST       // Lost the auction
}

// ========================================
// NEW FEATURES: Public Chat & Task Hall
// ========================================

// Public Chat Messages - Main public chat area
model PublicMessage {
  id      String @id @default(cuid())
  content String @db.Text // Message content

  // Sender info
  senderId String
  sender   User   @relation("PublicMessagesSent", fields: [senderId], references: [id], onDelete: Cascade)

  // Optional booth link - clicking username opens seller's booth
  linkedSellerId String?
  linkedSeller   SellerProfile? @relation("LinkedPublicMessages", fields: [linkedSellerId], references: [id], onDelete: Cascade)

  // Message metadata
  isSystemMessage Boolean @default(false)
  isAnnouncement  Boolean @default(false)
  priority        Int     @default(0) // Higher = more visible

  // Reactions
  reactions Json? // { "like": ["userId1", "userId2"], "fire": [...] }

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([senderId])
  @@index([isAnnouncement])
}

// Private Messages - 1:1 chat
model PrivateMessage {
  id      String @id @default(cuid())
  content String @db.Text

  // Participants
  senderId   String
  sender     User   @relation("PrivateMessagesSent", fields: [senderId], references: [id], onDelete: Cascade)
  receiverId String
  receiver   User   @relation("PrivateMessagesReceived", fields: [receiverId], references: [id], onDelete: Cascade)

  // Read status
  isRead Boolean   @default(false)
  readAt DateTime?

  createdAt DateTime @default(now())

  @@index([senderId, receiverId])
  @@index([receiverId, senderId])
  @@index([createdAt])
}

// Public Shout Outs - Public announcements with cost
model ShoutOut {
  id       String @id @default(cuid())
  content  String @db.Text
  senderId String
  sender   User   @relation(fields: [senderId], references: [id], onDelete: Cascade)

  // Payment info
  isFree    Boolean  @default(true)
  cost      Decimal? @db.Decimal(10, 2) // $0.10 per paid shout out
  paymentId String?

  // Display settings
  priority  Int       @default(1) // Display priority
  expiresAt DateTime? // When shout out expires

  // Engagement
  viewCount  Int   @default(0)
  clickCount Int   @default(0)
  reactions  Json?

  // Metadata
  type     String @default("general") // product, service, demand, general
  tags     String[]
  location String?

  createdAt DateTime @default(now())

  @@index([senderId])
  @@index([createdAt])
  @@index([priority])
}

// World Chat Messages - Global broadcast messages
model WorldChatMessage {
  id       String @id @default(cuid())
  content  String @db.Text

  senderId String
  sender   User   @relation(fields: [senderId], references: [id], onDelete: Cascade)

  // Payment info
  isFree    Boolean  @default(true)
  cost      Decimal? @db.Decimal(10, 2) // $0.10 per paid world message

  createdAt DateTime @default(now())

  @@index([senderId])
  @@index([createdAt])
}

// Notices - System notices that get pushed to users
model Notice {
  id       String @id @default(cuid())
  title    String
  content  String @db.Text

  senderId String
  sender   User   @relation(fields: [senderId], references: [id], onDelete: Cascade)

  priority String @default("medium") // low, medium, high, urgent
  isGlobal Boolean @default(true)
  expiresAt DateTime?

  createdAt DateTime @default(now())

  @@index([senderId])
  @@index([createdAt])
  @@index([priority])
}

// ========================================
// Auction Screen - Sell & Buy Listings
// ========================================

model AuctionListing {
  id   String             @id @default(cuid())
  type AuctionListingType // SELLING or BUYING

  // Listing details
  title       String
  description String?
  category    String?
  tags        String[]

  // Pricing
  price       Decimal? @db.Decimal(10, 2)
  currency    String   @default("USD")
  minOrderQty Int?
  maxOrderQty Int?

  // Media
  images    String[]
  videos    String[]
  documents String[]

  // Contact
  contactEmail    String?
  contactPhone    String?
  contactWeChat   String?
  contactWhatsApp String?

  // Seller/Buyer info
  posterId String
  poster   User   @relation(fields: [posterId], references: [id], onDelete: Cascade)

  // Optional seller profile link
  sellerId String?
  seller   SellerProfile? @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  // Listing cost
  isPaid    Boolean  @default(true)
  cost      Decimal? @db.Decimal(10, 2) // $0.10 per listing
  paymentId String?

  // Status
  status     AuctionStatus @default(ACTIVE)
  views      Int           @default(0)
  inquiries  Int           @default(0)
  isVerified Boolean       @default(false)

  expiresAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  // Relations
  bids AuctionBid[]

  // Digital voucher support
  digitalVoucherId String?
  digitalVoucher   DigitalVoucher? @relation(fields: [digitalVoucherId], references: [id])

  @@index([type])
  @@index([status])
  @@index([posterId])
  @@index([category])
  @@index([createdAt])
  @@index([isVerified])
}

enum AuctionListingType {
  SELLING // Selling products/services
  BUYING // Looking to buy products/services
}

enum AuctionStatus {
  ACTIVE // Currently listed
  EXPIRED // Listing expired
  CLOSED // Manually closed
  COMPLETED // Deal completed
}

// ========================================
// Digital Voucher System
// ========================================

enum VoucherStatus {
  CREATED
  PENDING_VERIFICATION
  VERIFIED
  LISTED
  TRANSFERRED
  REDEEMED
  EXPIRED
  CANCELLED
}

enum GoodsVerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

model DigitalVoucher {
  id       String        @id @default(cuid())
  sellerId String
  seller   SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  // Voucher details
  title       String
  description String?
  value       Decimal @db.Decimal(10, 2)
  currency    String  @default("USD")

  // Goods information (for hash generation)
  goodsName           String?
  goodsDescription    String?
  goodsQuantity       Int?
  goodsWeight         Float?
  goodsDimensions     String?
  goodsCategory       String?
  goodsOrigin         String?
  goodsSpecifications Json?

  // Redemption
  redemptionCode String    @unique
  isRedeemed     Boolean   @default(false)
  redeemedById   String?
  redeemedAt     DateTime?

  // Validity & status
  validFrom  DateTime
  validUntil DateTime?
  status     VoucherStatus             @default(CREATED)
  verificationStatus GoodsVerificationStatus @default(PENDING)
  issueDate  DateTime                  @default(now())

  // Security
  isVerified      Boolean  @default(false)
  securityHash    String?
  hashAlgorithm   String?  // SHA-256
  hashGeneratedAt DateTime?
  certificateNumber String? @unique

  // Metadata
  images    String[]
  documents Json?
  terms     String?

  // Logistics
  trackingNumber  String?
  logisticsStatus String?  // PENDING, IN_TRANSIT, DELIVERED

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions        DigitalVoucherTransaction[]
  auctionListings     AuctionListing[]
  verificationRecords GoodsVerificationRecord[]
  logisticsUpdates    LogisticsUpdate[]

  @@index([sellerId])
  @@index([redemptionCode])
  @@index([certificateNumber])
  @@index([isRedeemed])
  @@index([isVerified])
  @@index([status])
  @@index([verificationStatus])
}

model DigitalVoucherTransaction {
  id        String         @id @default(cuid())
  voucherId String
  voucher   DigitalVoucher @relation(fields: [voucherId], references: [id], onDelete: Cascade)

  buyerId String?
  buyer   User?   @relation(fields: [buyerId], references: [id])

  amount        Decimal @db.Decimal(10, 2)
  currency      String  @default("USD")
  transactionId String?
  transactionType String? // TRANSFER, REDEEM, VERIFY

  verifiedBy String?
  verifiedAt DateTime?

  deliveryInfo Json?

  status VoucherTransactionStatus @default(PENDING)

  createdAt DateTime @default(now())

  @@index([voucherId])
  @@index([buyerId])
  @@index([status])
}

enum VoucherTransactionStatus {
  PENDING
  VERIFIED
  IN_TRANSIT
  DELIVERED
  CANCELLED
}

model GoodsVerificationRecord {
  id        String         @id @default(cuid())
  voucherId String
  voucher   DigitalVoucher @relation(fields: [voucherId], references: [id], onDelete: Cascade)

  verifiedBy String?
  status     GoodsVerificationStatus @default(PENDING)
  notes      String?
  images     Json?

  createdAt DateTime @default(now())

  @@index([voucherId])
}

model LogisticsUpdate {
  id        String         @id @default(cuid())
  voucherId String
  voucher   DigitalVoucher @relation(fields: [voucherId], references: [id], onDelete: Cascade)

  status      String  // PENDING, PICKED_UP, IN_TRANSIT, OUT_FOR_DELIVERY, DELIVERED
  location    String?
  description String?
  timestamp   DateTime @default(now())

  createdAt DateTime @default(now())

  @@index([voucherId])
}

// ========================================
// Booth Customization & Analytics
// ========================================

model BoothCustomization {
  id       String        @id @default(cuid())
  sellerId String
  seller   SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  // Customization types
  type   BoothCustomizationType
  value  String?
  config Json? // Detailed configuration

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sellerId])
  @@index([type])
}

enum BoothCustomizationType {
  THEME
  COLOR_SCHEME
  LAYOUT
  BANNER
  DECOR
  ANIMATION
  FONT
  BACKGROUND
}

model BoothView {
  id       String        @id @default(cuid())
  sellerId String
  seller   SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  viewerId String?
  viewer   User?   @relation(fields: [viewerId], references: [id])

  // Analytics
  duration     Int? // Time spent in booth (seconds)
  interactions Json? // Which products were clicked
  referrer     String? // Where user came from

  // Device info
  deviceType String?
  country    String?
  city       String?

  viewedAt DateTime @default(now())

  @@index([sellerId])
  @@index([viewerId])
  @@index([viewedAt])
}

// ========================================
// AI Agent Permissions & Audit
// ========================================

model AIPermission {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  permission String // What the AI can do
  isAllowed  Boolean @default(true)
  scope      Json? // Limits/constraints

  grantedAt DateTime  @default(now())
  expiresAt DateTime?

  @@index([userId])
  @@index([permission])
}

model AIAuditLog {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  action   String // What the AI did
  target   String? // What was acted upon
  result   String? // Success/failure
  metadata Json? // Additional data

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
  @@index([action])
}

model AIAgent {
  id          String  @id @default(cuid())
  name        String
  description String?

  capabilities String[] // What the AI can do
  status       AIAgentStatus @default(PENDING)

  ownerId   String
  ownerType OwnerType // USER, SELLER, SYSTEM

  apiKey    String @unique
  secretKey String

  webhookUrl String?

  permissions Json // AIPermission data

  lastActiveAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  auditLogs AIAgentAuditLog[]

  @@index([apiKey])
  @@index([ownerId])
  @@index([status])
}

model AIAgentAuditLog {
  id      String  @id @default(cuid())
  agentId String
  agent   AIAgent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  action  String
  status  String // SUCCESS, DENIED, ERROR
  reason  String?
  details String?

  ipAddress String?
  userAgent String?

  createdAt DateTime @default(now())

  @@index([agentId])
  @@index([createdAt])
  @@index([action])
}

enum AIAgentStatus {
  PENDING
  ACTIVE
  SUSPENDED
  REVOKED
}

enum OwnerType {
  USER
  SELLER
  SYSTEM
}

// ==================== Wallet & Payment System ====================

// Payment gateways
enum PaymentGateway {
  ALIPAY
  WECHAT
  WORLDFIRST
  MANUAL
}

// Fee types
enum FeeType {
  SHOUT_OUT
  BOOTH_SUBSCRIPTION
  AUCTION_COMMISSION
  SYSTEM_NOTICE
  WITHDRAWAL
}

// User wallet
model Wallet {
  id             String   @id @default(cuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  balance        Decimal  @db.Decimal(10, 2) @default(0)
  currency       String   @default("USD")
  totalDeposited Decimal  @db.Decimal(10, 2) @default(0)
  totalWithdrawn Decimal  @db.Decimal(10, 2) @default(0)
  
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  
  transactions WalletTransaction[]
}

// Transaction type
enum TransactionType {
  DEPOSIT
  WITHDRAWAL
  PAYMENT
  REFUND
  FEE
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
  CANCELLED
}

// Wallet transactions
model WalletTransaction {
  id          String            @id @default(cuid())
  walletId    String
  wallet      Wallet            @relation(fields: [walletId], references: [id], onDelete: Cascade)
  
  type        TransactionType
  amount      Decimal           @db.Decimal(10, 2)
  status      TransactionStatus @default(PENDING)
  currency    String            @default("USD")
  
  reference   String?  // Related order/voucher/shout-out ID
  description String?
  gateway     PaymentGateway?
  gatewayTxId String?
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([walletId])
  @@index([type])
  @@index([status])
  @@index([createdAt])
}

// Platform fee configuration
model PlatformFee {
  id            String  @id @default(cuid())
  feeType       FeeType // SHOUT_OUT, BOOTH_SUBSCRIPTION, etc.
  amount        Decimal @db.Decimal(10, 2)
  currency      String  @default("USD")
  description   String?
  isActive      Boolean @default(true)
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  @@unique([feeType])
}

enum WithdrawalStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
}

// Withdrawal requests
model WithdrawalRequest {
  id              String           @id @default(cuid())
  userId          String
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  amount          Decimal          @db.Decimal(10, 2)
  currency        String           @default("USD")
  gateway         PaymentGateway
  gatewayDetails  Json?
  
  status          WithdrawalStatus @default(PENDING)
  
  // Admin review (use String for admin ID, no separate relation to avoid complexity)
  reviewedByAdmin String?
  reviewedAt      DateTime?
  reviewNotes     String?
  
  gatewayTxId     String?
  completedAt     DateTime?
  
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  
  @@index([userId])
  @@index([status])
  @@index([createdAt])
}
