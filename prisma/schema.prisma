generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                         String                      @id @default(cuid())
  email                      String
  username                   String                      @unique
  password                   String
  role                       UserRole                    @default(BUYER)
  isActive                   Boolean                     @default(true)
  lastLoginAt                DateTime?
  createdAt                  DateTime                    @default(now())
  updatedAt                  DateTime                    @updatedAt
  avatarUrl                  String?
  bio                        String?
  company                    String?
  displayName                String?
  location                   String?
  phone                      String?
  website                    String?
  aiCapabilities             Json?
  aiModel                    String?
  aiProvider                 String?
  dailyShoutOuts             Int                         @default(10)
  isOnline                   Boolean                     @default(false)
  isSystemAI                 Boolean                     @default(false)
  lastSeenAt                 DateTime?
  lastShoutOutDate           DateTime?
  resetToken                 String?
  resetTokenExpiry           DateTime?
  balance                    Decimal?                    @db.Decimal(10, 2)
  chatSystemLinkedAt         DateTime?
  chatSystemToken            String?
  chatSystemUserId           String?
  isAI                       Boolean                     @default(false)
  ownerId                    String?
  receiveNotices             Boolean                     @default(true)
  aiAuditLogs                AIAuditLog[]
  aiPermissions              AIPermission[]
  apiKeys                    APIKey[]
  apiUsageLogs               APIUsageLog[]
  auctionBids                AuctionBid[]
  auctionListings            AuctionListing[]
  orders                     Order[]            @relation("OrderBuyer")
  sellerOrders               Order[]            @relation("OrderSeller")
  escrowTransactionsAsBuyer  EscrowTransaction[] @relation("EscrowBuyer")
  escrowTransactionsAsSeller EscrowTransaction[] @relation("EscrowSeller")
  logisticsRecordsAsBuyer   LogisticsRecord[] @relation("LogisticsBuyer")
  disputesAsBuyer            Dispute[]          @relation("DisputeBuyer")
  disputesAsSeller           Dispute[]          @relation("DisputeSeller")
  boothViews                 BoothView[]
  brochuresDownloaded        BrochureDownload[]
  contactViews               ContactView[]
  digitalVoucherTransactions DigitalVoucherTransaction[]
  inquiries                  Inquiry[]
  marketplaceTasks           MarketplaceTask[]
  notices                    Notice[]
  paymentProofs              PaymentProof[]
  visitors                   Visitor[]
  privateMessagesReceived    PrivateMessage[]            @relation("PrivateMessagesReceived")
  privateMessagesSent        PrivateMessage[]            @relation("PrivateMessagesSent")
  publicMessagesSent         PublicMessage[]             @relation("PublicMessagesSent")
  sellerProfile              SellerProfile?
  submittedCategories        Category[]                 @relation("CategorySubmitter")
  shoutOuts                  ShoutOut[]
  taskApplications           TaskApplication[]
  owner                      User?                       @relation("AIOwner", fields: [ownerId], references: [id])
  aiAccounts                 User[]                      @relation("AIOwner")
  verificationRequests       VerificationRequest[]
  wallet                     Wallet?
  withdrawalRequests         WithdrawalRequest[]
  worldChatMessages          WorldChatMessage[]
  topics                     Topic[]
  topicComments              TopicComment[]
  topicLikes                 TopicLike[]
  blogPosts                  Blog[]
  blogComments               BlogComment[]
  blogLikes                  BlogLike[]
  reviews                    Review[]
  reviewHelpfulVotes         ReviewHelpfulVote[]

  @@unique([email, isAI, role])
  @@index([email])
  @@index([lastLoginAt])
  @@index([role])
  @@index([isOnline])
  @@index([dailyShoutOuts])
}

model SellerProfile {
  id                   String                   @id @default(cuid())
  userId               String                   @unique
  companyName          String
  contactName          String?
  companyType          CompanyType
  country              String
  city                 String
  address              String?
  phone                String?
  email                String?
  website              String?
  description          String?
  logoUrl              String?
  bannerUrl            String?
  certifications       String[]
  subscriptionStatus   SubscriptionStatus       @default(FREE_TRIAL)
  subscriptionExpiry   DateTime?
  isVerified           Boolean                  @default(false)
  isActive             Boolean                  @default(true)
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt
  boothCategories      String[]
  boothName            String?
  isCustomizable       Boolean                  @default(false)
  lastPaymentAt        DateTime?
  subscriptionAmount   Decimal?                 @db.Decimal(10, 2)
  facebook             String?
  instagram            String?
  linkedin             String?
  telegram             String?
  wechat               String?
  whatsapp             String?
  booth3DPreview       Boolean                  @default(false)
  boothAccentImage     String?
  boothAnimations      Boolean                  @default(false)
  boothBgImage         String?
  boothColor           String?
  boothFont            String?
  boothLayout          String?
  boothTags            String[]
  boothTheme           String?
  descriptions         Json?
  awards               String[]
  bankAccount          String?
  bilibili             String?
  boothNames           Json?
  businessAddress      String?
  businessScope        String?
  chatSystem           String?
  companyPhotos        String[]
  dingtalk             String?
  douyin               String?
  employeeCount        String?
  foundingYear         String?
  kuaishou             String?
  lark                 String?
  legalRepresentative  String?
  mapAddress           String?
  mapLatitude          Float?
  mapLongitude         Float?
  organizationType     OrganizationType         @default(ENTERPRISE)
  patents              String[]
  pinterest            String?
  profileReviewNotes   String?
  profileReviewedAt    DateTime?
  profileReviewedBy    String?
  profileStatus        ProfileStatus            @default(DRAFT)
  profileSubmittedAt   DateTime?
  qq                   String?
  reddit               String?
  registeredAddress    String?
  registeredCapital    String?
  registrationNumber   String?
  snapchat             String?
  taxNumber            String?
  teamPhotos           String[]
  tiktok               String?
  tumblr               String?
  twitter              String?
  wechatVideo          String?
  weibo                String?
  xiaohongshu          String?
  youtube              String?
  auctionListings      AuctionListing[]
  booths               Booth[]
  boothCustomizations  BoothCustomization[]
  boothViews           BoothView[]
  contactViews         ContactView[]
  digitalVouchers      DigitalVoucher[]
  inquiries            Inquiry[]
  paymentProofs        PaymentProof[]
  products             Product[]
  linkedPublicMessages PublicMessage[]          @relation("LinkedPublicMessages")
  reviews              Review[]
  submittedCategories  Category[]               @relation("SellerCategories")
  user                 User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  verificationFiles    SellerVerificationFile[]
  storeBrochures       StoreBrochure[]
  visitors             Visitor[]
  storeSlug            String?   @unique
  storeSlugLocked      Boolean   @default(false)
  storeSlugChangedAt   DateTime?

  @@index([companyName])
  @@index([country])
  @@index([storeSlug])
}

model Category {
  id            String     @id @default(cuid())
  name          String
  nameEn        String?
  slug          String     @unique
  level         Int
  parentId      String?
  model         String?
  modelEn       String?
  series        String?
  seriesEn      String?
  description   String?
  descriptionEn String?
  translations  Json?      // { en, zh, de, fr, es, ja, ko, ar, ru, pt, hi, th, vi }
  translatedAt  DateTime?  // Last auto-translation timestamp
  hsCode        String?
  // === 新增：来源与归属 ===
  source         CategorySource @default(SYSTEM)  // SYSTEM=系统预置, SELLER=卖家提交
  ownerId        String?                          // 卖家 SellerProfile.id（系统分类为 null）
  submittedById  String?                          // 提交者 User.id（含 AI 子账号，用于审计）
  submittedAt    DateTime?
  // === 新增：审核状态（默认 APPROVED 实现"自动同步"） ===
  status          CategoryStatus @default(APPROVED)
  reviewedAt      DateTime?
  reviewedBy      String?                          // 管理员 User.id
  rejectionReason String?
  parent        Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children      Category[] @relation("CategoryHierarchy")
  products      Product[]
  owner         SellerProfile? @relation("SellerCategories", fields: [ownerId], references: [id], onDelete: SetNull)
  submitter     User?          @relation("CategorySubmitter", fields: [submittedById], references: [id], onDelete: SetNull)

  @@index([slug])
  @@index([parentId])
  @@index([source])
  @@index([status])
  @@index([ownerId])
}

model Booth {
  id              String        @id @default(cuid())
  sellerId        String
  boothNumber     String        @unique
  boothCode       String?       @unique
  name            String
  names           Json?
  exhibitionName  String
  exhibitionDates Json?
  location        String?
  logoUrl         String?
  bannerUrl       String?
  keywords        Json?
  documents       Json?
  isActive        Boolean       @default(true)
  isPublished     Boolean       @default(false)
  theme           String?
  colorScheme     String?
  layout          String?
  viewCount       Int           @default(0)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  seller          SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  products        Product[]

  @@index([sellerId])
  @@index([isActive])
  @@index([isPublished])
  @@index([boothCode])
}

model Product {
  id             String           @id @default(cuid())
  sellerId       String
  categoryId     String
  title          String
  titleEn        String?
  description    String?
  specifications Json?
  minOrderQty    Int?
  minOrderUnitId String?
  supplyCapacity String?
  supplyCapacityUnitId String?
  mainImageUrl   String
  images         String[]
  videos         String[]
  documents      Json?
  hasBrochure    Boolean          @default(false)
  viewCount      Int              @default(0)
  inquiryCount   Int              @default(0)
  isActive       Boolean          @default(true)
  isFeatured     Boolean          @default(false)
  acceptsOEM     Boolean          @default(false)
  youtubeUrl     String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  boothId        String?
  descriptions   Json?
  titles         Json?
  keywords       Json?      // string[]，与 Booth.keywords 一致，用于产品搜索
  price          Decimal?         @db.Decimal(10, 2)
  currency       String?          @default("USD")
  unit           String?          @default("piece")
  inquiries      Inquiry[]
  reviews        Review[]
  booth          Booth?           @relation(fields: [boothId], references: [id])
  category       Category         @relation(fields: [categoryId], references: [id])
  seller         SellerProfile    @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  brochure       ProductBrochure?
  visitors      Visitor[]
  minOrderUnit   Unit?            @relation("ProductMinOrderUnit", fields: [minOrderUnitId], references: [id])
  supplyCapacityUnit Unit?        @relation("ProductSupplyCapacityUnit", fields: [supplyCapacityUnitId], references: [id])

  @@index([sellerId])
  @@index([boothId])
  @@index([categoryId])
  @@index([isActive])
  @@index([createdAt])
}

model ProductBrochure {
  id            String   @id @default(cuid())
  productId     String   @unique
  fileUrl       String
  fileName      String
  fileSize      Int
  downloadCount Int      @default(0)
  uploadedAt    DateTime @default(now())
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model StoreBrochure {
  id            String        @id @default(cuid())
  sellerId      String
  title         String
  fileUrl       String
  fileName      String
  fileSize      Int
  sortOrder     Int           @default(0)
  downloadCount Int           @default(0)
  createdAt     DateTime      @default(now())
  seller        SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  @@index([sellerId])
}

model BrochureDownload {
  id           String       @id @default(cuid())
  userId       String?
  brochureType BrochureType
  brochureId   String
  downloadedAt DateTime     @default(now())
  ipAddress    String?
  user         User?        @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([downloadedAt])
}

model Inquiry {
  id          String        @id @default(cuid())
  buyerId     String
  sellerId    String
  productId   String?
  message     String
  contactInfo String
  status      InquiryStatus @default(PENDING)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  buyer       User          @relation(fields: [buyerId], references: [id])
  product     Product?      @relation(fields: [productId], references: [id])
  seller      SellerProfile @relation(fields: [sellerId], references: [id])

  @@index([sellerId])
  @@index([buyerId])
  @@index([status])
}

model ContactView {
  id       String        @id @default(cuid())
  viewerId String
  sellerId String
  viewedAt DateTime      @default(now())
  seller   SellerProfile @relation(fields: [sellerId], references: [id])
  viewer   User          @relation(fields: [viewerId], references: [id])

  @@unique([viewerId, sellerId])
  @@index([sellerId])
}

model PaymentProof {
  id              String         @id @default(cuid())
  userId          String
  sellerProfileId String?
  amount          Decimal        @db.Decimal(10, 2)
  currency        String         @default("USD")
  transactionId   String?
  paymentMethod   String         @default("ALIPAY")
  screenshotUrl   String?
  notes           String?
  status          PaymentStatus  @default(PENDING)
  adminNotes      String?
  submittedAt     DateTime       @default(now())
  reviewedAt      DateTime?
  sellerProfile   SellerProfile? @relation(fields: [sellerProfileId], references: [id])
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([submittedAt])
}

model SellerVerificationFile {
  id                String               @id @default(cuid())
  sellerId          String
  fileType          VerificationFileType
  fileUrl           String
  fileName          String
  fileSize          Int
  mimeType          String?
  isVerified        Boolean              @default(false)
  verifiedAt        DateTime?
  verifiedBy        String?
  sortOrder         Int                  @default(0)
  description       String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  certificateName   String?
  certificateNumber String?
  expiryDate        String?
  issueDate         String?
  issuingAuthority  String?
  seller            SellerProfile        @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  @@index([sellerId])
  @@index([fileType])
  @@index([isVerified])
}

model SEOConfig {
  id            String   @id @default(cuid())
  pagePath      String   @unique
  title         String?
  titleEn       String?
  description   String?
  descriptionEn String?
  keywords      String?
  keywordsEn    String?
  pageType      PageType @default(STATIC)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([pageType])
  @@index([isActive])
}

model DeadLink {
  id            String    @id @default(cuid())
  url           String    @unique
  sourceUrl     String?
  statusCode    Int
  isResolved    Boolean   @default(false)
  resolvedAt    DateTime?
  detectedAt    DateTime  @default(now())
  lastCheckedAt DateTime  @default(now())

  @@index([isResolved])
  @@index([detectedAt])
}

model APIKey {
  id          String        @id @default(cuid())
  userId      String
  key         String        @unique
  name        String        @default("AI Agent Key")
  role        String
  permissions Json          @default("{}")
  rateLimit   Int           @default(1000)
  isActive    Boolean       @default(true)
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  usageLogs   APIUsageLog[]

  @@index([userId])
  @@index([key])
  @@index([isActive])
}

model APIUsageLog {
  id           String   @id @default(cuid())
  apiKeyId     String
  userId       String
  endpoint     String
  method       String
  statusCode   Int?
  responseTime Int?
  ipAddress    String?
  userAgent    String?
  metadata     Json?
  createdAt    DateTime @default(now())
  apiKey       APIKey   @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([apiKeyId])
  @@index([createdAt])
  @@index([endpoint])
}

model MarketplaceTask {
  id               String            @id @default(cuid())
  title            String
  description      String
  type             TaskType
  budget           Decimal?          @db.Decimal(10, 2)
  price            Decimal?          @db.Decimal(10, 2)
  currency         String            @default("USD")
  unit             String?
  minOrderQty      Int?
  deadline         DateTime?
  status           TaskStatus        @default(OPEN)
  postedById       String
  contactInfo      String?
  applications     Int               @default(0)
  views            Int               @default(0)
  rating           Decimal?          @db.Decimal(3, 2)
  attachments      Json?
  keywords         Json?
  countryCode      String?
  countryName      String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  postedBy         User              @relation(fields: [postedById], references: [id])
  taskApplications TaskApplication[]
  taskDeliverables TaskDeliverable[]
  taskEscrow       TaskEscrow?
  taskMilestones   TaskMilestone[]

  @@index([status])
  @@index([type])
  @@index([postedById])
  @@index([createdAt])
}

model TaskApplication {
  id           String            @id @default(cuid())
  taskId       String
  applicantId  String
  message      String
  quote        Decimal?          @db.Decimal(10, 2)
  deliveryTime String?
  status       ApplicationStatus @default(PENDING)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  applicant    User              @relation(fields: [applicantId], references: [id])
  task         MarketplaceTask   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([applicantId])
  @@index([status])
}

model TaskMilestone {
  id          String          @id @default(cuid())
  taskId      String
  title       String
  description String?
  amount      Decimal         @db.Decimal(10, 2)
  order       Int
  status      MilestoneStatus @default(PENDING)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  task        MarketplaceTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([status])
}

model TaskDeliverable {
  id          String            @id @default(cuid())
  taskId      String
  title       String
  description String?
  files       Json?
  submittedAt DateTime?
  status      DeliverableStatus @default(DRAFT)
  reviewNotes String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  task        MarketplaceTask   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([status])
}

model TaskEscrow {
  id            String          @id @default(cuid())
  taskId        String          @unique
  amount        Decimal         @db.Decimal(10, 2)
  currency      String          @default("USD")
  holdAmount    Decimal         @db.Decimal(10, 2)
  releaseAmount Decimal         @db.Decimal(10, 2)
  status        EscrowStatus    @default(PENDING)
  transactionId String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  task          MarketplaceTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([status])
}

model AuctionBid {
  id         String           @id @default(cuid())
  listingId  String
  bidderId   String
  amount     Decimal          @db.Decimal(10, 2)
  currency   String           @default("USD")
  isAutoBid  Boolean          @default(false)
  maxAutoBid Decimal?         @db.Decimal(10, 2)
  status     AuctionBidStatus @default(PENDING)
  createdAt  DateTime         @default(now())
  bidder     User             @relation(fields: [bidderId], references: [id], onDelete: Cascade)
  listing    AuctionListing   @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId])
  @@index([bidderId])
  @@index([status])
  @@index([createdAt])
}

model PublicMessage {
  id              String         @id @default(cuid())
  content         String
  senderId        String
  linkedSellerId  String?
  isSystemMessage Boolean        @default(false)
  isAnnouncement  Boolean        @default(false)
  priority        Int            @default(0)
  reactions       Json?
  createdAt       DateTime       @default(now())
  fileName        String?
  fileSize        Int?
  fileUrl         String?
  isWorldChat     Boolean        @default(false)
  messageType     MessageType    @default(TEXT)
  mimeType        String?
  linkedSeller    SellerProfile? @relation("LinkedPublicMessages", fields: [linkedSellerId], references: [id], onDelete: Cascade)
  sender          User           @relation("PublicMessagesSent", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([senderId])
  @@index([isAnnouncement])
  @@index([messageType])
}

model PrivateMessage {
  id         String    @id @default(cuid())
  content    String
  senderId   String
  receiverId String
  isRead     Boolean   @default(false)
  readAt     DateTime?
  createdAt  DateTime  @default(now())
  receiver   User      @relation("PrivateMessagesReceived", fields: [receiverId], references: [id], onDelete: Cascade)
  sender     User      @relation("PrivateMessagesSent", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([senderId, receiverId])
  @@index([receiverId, senderId])
  @@index([createdAt])
}

model ShoutOut {
  id         String    @id @default(cuid())
  content    String
  senderId   String
  isFree     Boolean   @default(true)
  cost       Decimal?  @db.Decimal(10, 2)
  paymentId  String?
  priority   Int       @default(1)
  expiresAt  DateTime?
  viewCount  Int       @default(0)
  clickCount Int       @default(0)
  reactions  Json?
  createdAt  DateTime  @default(now())
  location   String?
  tags       String[]
  type       String    @default("general")
  sender     User      @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([senderId])
  @@index([createdAt])
  @@index([priority])
}

model WorldChatMessage {
  id        String   @id @default(cuid())
  content   String
  senderId  String
  isFree    Boolean  @default(true)
  cost      Decimal? @db.Decimal(10, 2)
  createdAt DateTime @default(now())
  sender    User     @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([senderId])
  @@index([createdAt])
}

model Notice {
  id        String    @id @default(cuid())
  title     String
  content   String
  senderId  String
  priority  String    @default("medium")
  isGlobal  Boolean   @default(true)
  expiresAt DateTime?
  createdAt DateTime  @default(now())
  sender    User      @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([senderId])
  @@index([createdAt])
  @@index([priority])
}

model Unit {
  id              String           @id @default(cuid())
  name            String
  nameEn          String
  symbol          String?
  description     String?
  isEnabled       Boolean          @default(true)
  sortOrder       Int              @default(0)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  auctionListings AuctionListing[]
  productsMinOrder Product[]       @relation("ProductMinOrderUnit")
  productsSupplyCapacity Product[] @relation("ProductSupplyCapacityUnit")

  @@index([name])
  @@index([isEnabled])
}

model AuctionListing {
  id                   String                @id @default(cuid())
  type                 AuctionListingType
  title                String
  description          String?
  category             String?
  tags                 String[]
  price                Decimal?              @db.Decimal(10, 2)
  currency             String                @default("USD")
  minOrderQty          Int?                  @default(1)
  maxOrderQty          Int?
  stockQuantity        Int                   @default(0)
  soldQuantity         Int                   @default(0)
  images               String[]
  videos               String[]
  documents            String[]
  contactEmail         String?
  contactPhone         String?
  contactWeChat        String?
  contactWhatsApp      String?
  posterId             String
  sellerId             String?
  isPaid               Boolean               @default(true)
  cost                 Decimal?              @db.Decimal(10, 2)
  paymentId            String?
  status               AuctionStatus         @default(ACTIVE)
  views                Int                   @default(0)
  inquiries            Int                   @default(0)
  isVerified           Boolean               @default(false)
  expiresAt            DateTime?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  digitalVoucherId     String?
  techSpecs            String?
  productFeatures      String?
  applicationScope     String?
  usageMethod          String?
  shippingCountry      String?
  detailedAddress      String?
  isFob                String?
  isCif                String?
  verificationStatus   VerificationStatus    @default(NOT_APPLIED)
  verificationFee      Decimal?              @db.Decimal(10, 2)
  verificationNotes    String?
  unitId               String?
  hsCode               String?
  hsCodeDescription    String?
  paymentMethods       Json?
  freightItems         Json?
  exportDocuments      Json?
  hasExportLicense     Boolean               @default(false)
  exportLicenseNo      String?
