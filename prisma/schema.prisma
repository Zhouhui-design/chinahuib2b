generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                         String                      @id @default(cuid())
  email                      String                      @unique
  username                   String                      @unique
  password                   String
  role                       UserRole                    @default(BUYER)
  isActive                   Boolean                     @default(true)
  lastLoginAt                DateTime?
  createdAt                  DateTime                    @default(now())
  updatedAt                  DateTime                    @updatedAt
  avatarUrl                  String?
  bio                        String?
  company                    String?
  displayName                String?
  location                   String?
  phone                      String?
  website                    String?
  aiCapabilities             Json?
  aiModel                    String?
  aiProvider                 String?
  dailyShoutOuts             Int                         @default(10)
  isOnline                   Boolean                     @default(false)
  isSystemAI                 Boolean                     @default(false)
  lastSeenAt                 DateTime?
  lastShoutOutDate           DateTime?
  resetToken                 String?
  resetTokenExpiry           DateTime?
  balance                    Decimal?                    @db.Decimal(10, 2)
  chatSystemLinkedAt         DateTime?
  chatSystemToken            String?
  chatSystemUserId           String?
  isAI                       Boolean                     @default(false)
  ownerId                    String?
  receiveNotices             Boolean                     @default(true)
  aiAuditLogs                AIAuditLog[]
  aiPermissions              AIPermission[]
  apiKeys                    APIKey[]
  apiUsageLogs               APIUsageLog[]
  auctionBids                AuctionBid[]
  auctionListings            AuctionListing[]
  boothViews                 BoothView[]
  brochuresDownloaded        BrochureDownload[]
  contactViews               ContactView[]
  digitalVoucherTransactions DigitalVoucherTransaction[]
  inquiries                  Inquiry[]
  marketplaceTasks           MarketplaceTask[]
  notices                    Notice[]
  paymentProofs              PaymentProof[]
  privateMessagesReceived    PrivateMessage[]            @relation("PrivateMessagesReceived")
  privateMessagesSent        PrivateMessage[]            @relation("PrivateMessagesSent")
  publicMessagesSent         PublicMessage[]             @relation("PublicMessagesSent")
  sellerProfile              SellerProfile?
  shoutOuts                  ShoutOut[]
  taskApplications           TaskApplication[]
  owner                      User?                       @relation("AIOwner", fields: [ownerId], references: [id])
  aiAccounts                 User[]                      @relation("AIOwner")
  verificationRequests       VerificationRequest[]
  wallet                     Wallet?
  withdrawalRequests         WithdrawalRequest[]
  worldChatMessages          WorldChatMessage[]
  topics                     Topic[]
  topicComments              TopicComment[]
  topicLikes                 TopicLike[]

  @@index([email])
  @@index([lastLoginAt])
  @@index([role])
  @@index([isOnline])
  @@index([dailyShoutOuts])
}

model SellerProfile {
  id                   String                   @id @default(cuid())
  userId               String                   @unique
  companyName          String
  companyType          CompanyType
  country              String
  city                 String
  address              String?
  phone                String?
  email                String?
  website              String?
  description          String?
  logoUrl              String?
  bannerUrl            String?
  certifications       String[]
  subscriptionStatus   SubscriptionStatus       @default(FREE_TRIAL)
  subscriptionExpiry   DateTime?
  isVerified           Boolean                  @default(false)
  isActive             Boolean                  @default(true)
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt
  boothCategories      String[]
  boothName            String?
  isCustomizable       Boolean                  @default(false)
  lastPaymentAt        DateTime?
  subscriptionAmount   Decimal?                 @db.Decimal(10, 2)
  facebook             String?
  instagram            String?
  linkedin             String?
  telegram             String?
  wechat               String?
  whatsapp             String?
  booth3DPreview       Boolean                  @default(false)
  boothAccentImage     String?
  boothAnimations      Boolean                  @default(false)
  boothBgImage         String?
  boothColor           String?
  boothFont            String?
  boothLayout          String?
  boothTags            String[]
  boothTheme           String?
  descriptions         Json?
  awards               String[]
  bankAccount          String?
  bilibili             String?
  boothNames           Json?
  businessAddress      String?
  businessScope        String?
  chatSystem           String?
  companyPhotos        String[]
  dingtalk             String?
  douyin               String?
  employeeCount        String?
  foundingYear         String?
  kuaishou             String?
  lark                 String?
  legalRepresentative  String?
  mapAddress           String?
  mapLatitude          Float?
  mapLongitude         Float?
  organizationType     OrganizationType         @default(ENTERPRISE)
  patents              String[]
  pinterest            String?
  profileReviewNotes   String?
  profileReviewedAt    DateTime?
  profileReviewedBy    String?
  profileStatus        ProfileStatus            @default(DRAFT)
  profileSubmittedAt   DateTime?
  qq                   String?
  reddit               String?
  registeredAddress    String?
  registeredCapital    String?
  registrationNumber   String?
  snapchat             String?
  taxNumber            String?
  teamPhotos           String[]
  tiktok               String?
  tumblr               String?
  twitter              String?
  wechatVideo          String?
  weibo                String?
  xiaohongshu          String?
  youtube              String?
  auctionListings      AuctionListing[]
  booths               Booth[]
  boothCustomizations  BoothCustomization[]
  boothViews           BoothView[]
  contactViews         ContactView[]
  digitalVouchers      DigitalVoucher[]
  inquiries            Inquiry[]
  visitors             Visitor[]
  paymentProofs        PaymentProof[]
  products             Product[]
  linkedPublicMessages PublicMessage[]          @relation("LinkedPublicMessages")
  user                 User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  verificationFiles    SellerVerificationFile[]
  storeBrochures       StoreBrochure[]

  @@index([companyName])
  @@index([country])
}

model Category {
  id            String     @id @default(cuid())
  name          String
  nameEn        String?
  slug          String     @unique
  level         Int
  parentId      String?
  model         String?
  modelEn       String?
  series        String?
  seriesEn      String?
  description   String?
  descriptionEn String?
  hsCode        String?
  parent        Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children      Category[] @relation("CategoryHierarchy")
  products      Product[]

  @@index([slug])
  @@index([parentId])
}

model Booth {
  id              String        @id @default(cuid())
  sellerId        String
  boothNumber     String        @unique
  name            String
  names           Json?
  exhibitionName  String
  exhibitionDates Json?
  location        String?
  logoUrl         String?
  bannerUrl       String?
  keywords        Json?
  documents       Json?
  isActive        Boolean       @default(true)
  isPublished     Boolean       @default(false)
  theme           String?
  colorScheme     String?
  layout          String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  seller          SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  products        Product[]

  @@index([sellerId])
  @@index([isActive])
  @@index([isPublished])
}

model Product {
  id             String           @id @default(cuid())
  sellerId       String
  categoryId     String
  title          String
  titleEn        String?
  description    String?
  specifications Json?
  minOrderQty    Int?
  supplyCapacity String?
  mainImageUrl   String
  images         String[]
  videos         String[]
  documents      Json?
  hasBrochure    Boolean          @default(false)
  acceptsOEM     Boolean          @default(false)
  youtubeUrl     String?
  viewCount      Int              @default(0)
  inquiryCount   Int              @default(0)
  isActive       Boolean          @default(true)
  isFeatured     Boolean          @default(false)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  boothId        String?
  descriptions   Json?
  titles         Json?
  inquiries      Inquiry[]
  booth          Booth?           @relation(fields: [boothId], references: [id])
  category       Category         @relation(fields: [categoryId], references: [id])
  seller         SellerProfile    @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  brochure       ProductBrochure?
  visitors       Visitor[]

  @@index([sellerId])
  @@index([boothId])
  @@index([categoryId])
  @@index([isActive])
  @@index([createdAt])
}

model ProductBrochure {
  id            String   @id @default(cuid())
  productId     String   @unique
  fileUrl       String
  fileName      String
  fileSize      Int
  downloadCount Int      @default(0)
  uploadedAt    DateTime @default(now())
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model Visitor {
  id          String        @id @default(cuid())
  ipHash      String
  productId   String?
  sellerId    String?
  country     String
  countryCode String
  city        String
  region      String?
  timezone    String?
  isp         String?
  userAgent   String?
  url         String?
  createdAt   DateTime      @default(now())
  product     Product?      @relation(fields: [productId], references: [id], onDelete: Cascade)
  seller      SellerProfile? @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([sellerId])
  @@index([country])
  @@index([countryCode])
  @@index([createdAt])
}

model StoreBrochure {
  id            String        @id @default(cuid())
  sellerId      String
  title         String
  fileUrl       String
  fileName      String
  fileSize      Int
  sortOrder     Int           @default(0)
  downloadCount Int           @default(0)
  createdAt     DateTime      @default(now())
  seller        SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  @@index([sellerId])
}

model BrochureDownload {
  id           String       @id @default(cuid())
  userId       String?
  brochureType BrochureType
  brochureId   String
  downloadedAt DateTime     @default(now())
  ipAddress    String?
  user         User?        @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([downloadedAt])
}

model Inquiry {
  id          String        @id @default(cuid())
  buyerId     String
  sellerId    String
  productId   String?
  message     String
  contactInfo String
  status      InquiryStatus @default(PENDING)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  buyer       User          @relation(fields: [buyerId], references: [id])
  product     Product?      @relation(fields: [productId], references: [id])
  seller      SellerProfile @relation(fields: [sellerId], references: [id])

  @@index([sellerId])
  @@index([buyerId])
  @@index([status])
}

model ContactView {
  id       String        @id @default(cuid())
  viewerId String
  sellerId String
  viewedAt DateTime      @default(now())
  seller   SellerProfile @relation(fields: [sellerId], references: [id])
  viewer   User          @relation(fields: [viewerId], references: [id])

  @@unique([viewerId, sellerId])
  @@index([sellerId])
}

model PaymentProof {
  id              String         @id @default(cuid())
  userId          String
  sellerProfileId String?
  amount          Decimal        @db.Decimal(10, 2)
  currency        String         @default("USD")
  transactionId   String?
  paymentMethod   String         @default("ALIPAY")
  screenshotUrl   String?
  notes           String?
  status          PaymentStatus  @default(PENDING)
  adminNotes      String?
  submittedAt     DateTime       @default(now())
  reviewedAt      DateTime?
  sellerProfile   SellerProfile? @relation(fields: [sellerProfileId], references: [id])
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([submittedAt])
}

model SellerVerificationFile {
  id                String               @id @default(cuid())
  sellerId          String
  fileType          VerificationFileType
  fileUrl           String
  fileName          String
  fileSize          Int
  mimeType          String?
  isVerified        Boolean              @default(false)
  verifiedAt        DateTime?
  verifiedBy        String?
  sortOrder         Int                  @default(0)
  description       String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  certificateName   String?
  certificateNumber String?
  expiryDate        String?
  issueDate         String?
  issuingAuthority  String?
  seller            SellerProfile        @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  @@index([sellerId])
  @@index([fileType])
  @@index([isVerified])
}

model SEOConfig {
  id            String   @id @default(cuid())
  pagePath      String   @unique
  title         String?
  titleEn       String?
  description   String?
  descriptionEn String?
  keywords      String?
  keywordsEn    String?
  pageType      PageType @default(STATIC)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([pageType])
  @@index([isActive])
}

model DeadLink {
  id            String    @id @default(cuid())
  url           String    @unique
  sourceUrl     String?
  statusCode    Int
  isResolved    Boolean   @default(false)
  resolvedAt    DateTime?
  detectedAt    DateTime  @default(now())
  lastCheckedAt DateTime  @default(now())

  @@index([isResolved])
  @@index([detectedAt])
}

model APIKey {
  id          String        @id @default(cuid())
  userId      String
  key         String        @unique
  name        String        @default("AI Agent Key")
  role        String
  permissions Json          @default("{}")
  rateLimit   Int           @default(1000)
  isActive    Boolean       @default(true)
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  usageLogs   APIUsageLog[]

  @@index([userId])
  @@index([key])
  @@index([isActive])
}

model APIUsageLog {
  id           String   @id @default(cuid())
  apiKeyId     String
  userId       String
  endpoint     String
  method       String
  statusCode   Int?
  responseTime Int?
  ipAddress    String?
  userAgent    String?
  metadata     Json?
  createdAt    DateTime @default(now())
  apiKey       APIKey   @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([apiKeyId])
  @@index([createdAt])
  @@index([endpoint])
}

model MarketplaceTask {
  id               String            @id @default(cuid())
  title            String
  description      String
  type             TaskType
  budget           Decimal?          @db.Decimal(10, 2)
  price            Decimal?          @db.Decimal(10, 2)
  currency         String            @default("USD")
  unit             String?
  minOrderQty      Int?
  deadline         DateTime?
  status           TaskStatus        @default(OPEN)
  postedById       String
  contactInfo      String?
  applications     Int               @default(0)
  views            Int               @default(0)
  rating           Decimal?          @db.Decimal(3, 2)
  attachments      Json?
  keywords         String[]          @default([])
  countryCode      String?
  countryName      String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  postedBy         User              @relation(fields: [postedById], references: [id])
  taskApplications TaskApplication[]
  taskDeliverables TaskDeliverable[]
  taskEscrow       TaskEscrow?
  taskMilestones   TaskMilestone[]

  @@index([status])
  @@index([type])
  @@index([postedById])
  @@index([createdAt])
}

model TaskApplication {
  id           String            @id @default(cuid())
  taskId       String
  applicantId  String
  message      String
  quote        Decimal?          @db.Decimal(10, 2)
  deliveryTime String?
  status       ApplicationStatus @default(PENDING)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  applicant    User              @relation(fields: [applicantId], references: [id])
  task         MarketplaceTask   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([applicantId])
  @@index([status])
}

model TaskMilestone {
  id          String          @id @default(cuid())
  taskId      String
  title       String
  description String?
  amount      Decimal         @db.Decimal(10, 2)
  order       Int
  status      MilestoneStatus @default(PENDING)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  task        MarketplaceTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([status])
}

model TaskDeliverable {
  id          String            @id @default(cuid())
  taskId      String
  title       String
  description String?
  files       Json?
  submittedAt DateTime?
  status      DeliverableStatus @default(DRAFT)
  reviewNotes String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  task        MarketplaceTask   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([status])
}

model TaskEscrow {
  id            String          @id @default(cuid())
  taskId        String          @unique
  amount        Decimal         @db.Decimal(10, 2)
  currency      String          @default("USD")
  holdAmount    Decimal         @db.Decimal(10, 2)
  releaseAmount Decimal         @db.Decimal(10, 2)
  status        EscrowStatus    @default(PENDING)
  transactionId String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  task          MarketplaceTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([status])
}

model AuctionBid {
  id         String           @id @default(cuid())
  listingId  String
  bidderId   String
  amount     Decimal          @db.Decimal(10, 2)
  currency   String           @default("USD")
  isAutoBid  Boolean          @default(false)
  maxAutoBid Decimal?         @db.Decimal(10, 2)
  status     AuctionBidStatus @default(PENDING)
  createdAt  DateTime         @default(now())
  bidder     User             @relation(fields: [bidderId], references: [id], onDelete: Cascade)
  listing    AuctionListing   @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId])
  @@index([bidderId])
  @@index([status])
  @@index([createdAt])
}

model PublicMessage {
  id              String         @id @default(cuid())
  content         String
  senderId        String
  linkedSellerId  String?
  isSystemMessage Boolean        @default(false)
  isAnnouncement  Boolean        @default(false)
  priority        Int            @default(0)
  reactions       Json?
  createdAt       DateTime       @default(now())
  fileName        String?
  fileSize        Int?
  fileUrl         String?
  isWorldChat     Boolean        @default(false)
  messageType     MessageType    @default(TEXT)
  mimeType        String?
  linkedSeller    SellerProfile? @relation("LinkedPublicMessages", fields: [linkedSellerId], references: [id], onDelete: Cascade)
  sender          User           @relation("PublicMessagesSent", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([senderId])
  @@index([isAnnouncement])
  @@index([messageType])
}

model PrivateMessage {
  id         String    @id @default(cuid())
  content    String
  senderId   String
  receiverId String
  isRead     Boolean   @default(false)
  readAt     DateTime?
  createdAt  DateTime  @default(now())
  receiver   User      @relation("PrivateMessagesReceived", fields: [receiverId], references: [id], onDelete: Cascade)
  sender     User      @relation("PrivateMessagesSent", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([senderId, receiverId])
  @@index([receiverId, senderId])
  @@index([createdAt])
}

model ShoutOut {
  id         String    @id @default(cuid())
  content    String
  senderId   String
  isFree     Boolean   @default(true)
  cost       Decimal?  @db.Decimal(10, 2)
  paymentId  String?
  priority   Int       @default(1)
  expiresAt  DateTime?
  viewCount  Int       @default(0)
  clickCount Int       @default(0)
  reactions  Json?
  createdAt  DateTime  @default(now())
  location   String?
  tags       String[]
  type       String    @default("general")
  sender     User      @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([senderId])
  @@index([createdAt])
  @@index([priority])
}

model WorldChatMessage {
  id        String   @id @default(cuid())
  content   String
  senderId  String
  isFree    Boolean  @default(true)
  cost      Decimal? @db.Decimal(10, 2)
  createdAt DateTime @default(now())
  sender    User     @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([senderId])
  @@index([createdAt])
}

model Notice {
  id        String    @id @default(cuid())
  title     String
  content   String
  senderId  String
  priority  String    @default("medium")
  isGlobal  Boolean   @default(true)
  expiresAt DateTime?
  createdAt DateTime  @default(now())
  sender    User      @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([senderId])
  @@index([createdAt])
  @@index([priority])
}

model MaintenanceNotice {
  id             String                 @id @default(cuid())
  title          String
  titleEn        String?
  content        String
  contentEn      String?
  status         MaintenanceStatus      @default(PENDING)
  priority       String                 @default("high")
  scheduledStart DateTime?
  estimatedDuration Int?
  actualEndTime  DateTime?
  notifiedUsers  Int                    @default(0)
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  @@index([status])
  @@index([priority])
  @@index([scheduledStart])
}

enum MaintenanceStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

model Unit {
  id              String           @id @default(cuid())
  name            String
  nameEn          String
  symbol          String?
  description     String?
  isEnabled       Boolean          @default(true)
  sortOrder       Int              @default(0)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  auctionListings AuctionListing[]

  @@index([name])
  @@index([isEnabled])
}

model AuctionListing {
  id                   String                @id @default(cuid())
  type                 AuctionListingType
  title                String
  description          String?
  category             String?
  tags                 String[]
  keywords             String[]
  price                Decimal?              @db.Decimal(10, 2)
  currency             String                @default("USD")
  minOrderQty          Int?                  @default(1)
  maxOrderQty          Int?
  images               String[]
  videos               String[]
  documents            String[]
  contactEmail         String?
  contactPhone         String?
  contactWeChat        String?
  contactWhatsApp      String?
  posterId             String
  sellerId             String?
  isPaid               Boolean               @default(true)
  cost                 Decimal?              @db.Decimal(10, 2)
  paymentId            String?
  status               AuctionStatus         @default(ACTIVE)
  views                Int                   @default(0)
  inquiries            Int                   @default(0)
  isVerified           Boolean               @default(false)
  expiresAt            DateTime?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  digitalVoucherId     String?
  techSpecs            String?
  productFeatures      String?
  applicationScope     String?
  usageMethod          String?
  shippingCountry      String?
  detailedAddress      String?
  isFob                String?
  isCif                String?
  verificationStatus   VerificationStatus    @default(NOT_APPLIED)
  verificationFee      Decimal?              @db.Decimal(10, 2)
  verificationNotes    String?
  unitId               String?
  bids                 AuctionBid[]
  digitalVoucher       DigitalVoucher?       @relation(fields: [digitalVoucherId], references: [id])
  poster               User                  @relation(fields: [posterId], references: [id], onDelete: Cascade)
  seller               SellerProfile?        @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  unit                 Unit?                 @relation(fields: [unitId], references: [id])
  verificationRequests VerificationRequest[]

  @@index([type])
  @@index([status])
  @@index([posterId])
  @@index([category])
  @@index([createdAt])
  @@index([isVerified])
  @@index([verificationStatus])
}

model DigitalVoucher {
  id                  String                      @id @default(cuid())
  sellerId            String
  title               String
  description         String?
  value               Decimal                     @db.Decimal(10, 2)
  currency            String                      @default("USD")
  redemptionCode      String                      @unique
  isRedeemed          Boolean                     @default(false)
  redeemedById        String?
  redeemedAt          DateTime?
  validFrom           DateTime
  validUntil          DateTime?
  isVerified          Boolean                     @default(false)
  securityHash        String?
  images              String[]
  terms               String?
  createdAt           DateTime                    @default(now())
  updatedAt           DateTime                    @updatedAt
  certificateNumber   String?                     @unique
  documents           Json?
  goodsCategory       String?
  goodsDescription    String?
  goodsDimensions     String?
  goodsName           String?
  goodsOrigin         String?
  goodsQuantity       Int?
  goodsSpecifications Json?
  goodsWeight         Float?
  hashAlgorithm       String?
  hashGeneratedAt     DateTime?
  issueDate           DateTime                    @default(now())
  logisticsStatus     String?
  status              VoucherStatus               @default(CREATED)
  trackingNumber      String?
  verificationStatus  GoodsVerificationStatus     @default(PENDING)
  auctionListings     AuctionListing[]
  seller              SellerProfile               @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  transactions        DigitalVoucherTransaction[]
  verificationRecords GoodsVerificationRecord[]
  logisticsUpdates    LogisticsUpdate[]

  @@index([sellerId])
  @@index([redemptionCode])
  @@index([certificateNumber])
  @@index([isRedeemed])
  @@index([isVerified])
  @@index([status])
  @@index([verificationStatus])
}

model DigitalVoucherTransaction {
  id              String                   @id @default(cuid())
  voucherId       String
  buyerId         String?
  amount          Decimal                  @db.Decimal(10, 2)
  currency        String                   @default("USD")
  transactionId   String?
  verifiedBy      String?
  verifiedAt      DateTime?
  deliveryInfo    Json?
  status          VoucherTransactionStatus @default(PENDING)
  createdAt       DateTime                 @default(now())
  transactionType String?
  buyer           User?                    @relation(fields: [buyerId], references: [id])
  voucher         DigitalVoucher           @relation(fields: [voucherId], references: [id], onDelete: Cascade)

  @@index([voucherId])
  @@index([buyerId])
  @@index([status])
}

model GoodsVerificationRecord {
  id         String                  @id @default(cuid())
  voucherId  String
  verifiedBy String?
  status     GoodsVerificationStatus @default(PENDING)
  notes      String?
  images     Json?
  createdAt  DateTime                @default(now())
  voucher    DigitalVoucher          @relation(fields: [voucherId], references: [id], onDelete: Cascade)

  @@index([voucherId])
}

model LogisticsUpdate {
  id          String         @id @default(cuid())
  voucherId   String
  status      String
  location    String?
  description String?
  timestamp   DateTime       @default(now())
  createdAt   DateTime       @default(now())
  voucher     DigitalVoucher @relation(fields: [voucherId], references: [id], onDelete: Cascade)

  @@index([voucherId])
}

model BoothCustomization {
  id        String                 @id @default(cuid())
  sellerId  String
  type      BoothCustomizationType
  value     String?
  config    Json?
  isActive  Boolean                @default(true)
  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt
  seller    SellerProfile          @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  @@index([sellerId])
  @@index([type])
}

model BoothView {
  id           String        @id @default(cuid())
  sellerId     String
  viewerId     String?
  duration     Int?
  interactions Json?
  referrer     String?
  deviceType   String?
  country      String?
  city         String?
  viewedAt     DateTime      @default(now())
  seller       SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  viewer       User?         @relation(fields: [viewerId], references: [id])

  @@index([sellerId])
  @@index([viewerId])
  @@index([viewedAt])
}

model AIPermission {
  id         String    @id @default(cuid())
  userId     String
  permission String
  isAllowed  Boolean   @default(true)
  scope      Json?
  grantedAt  DateTime  @default(now())
  expiresAt  DateTime?
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([permission])
}

model AIAuditLog {
  id        String   @id @default(cuid())
  userId    String
  action    String
  target    String?
  result    String?
  metadata  Json?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@index([action])
}

model AIAgent {
  id           String            @id @default(cuid())
  name         String
  description  String?
  capabilities String[]
  status       AIAgentStatus     @default(PENDING)
  ownerId      String
  ownerType    OwnerType
  apiKey       String            @unique
  secretKey    String
  webhookUrl   String?
  permissions  Json
  lastActiveAt DateTime?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  auditLogs    AIAgentAuditLog[]

  @@index([apiKey])
  @@index([ownerId])
  @@index([status])
}

model AIAgentAuditLog {
  id        String   @id @default(cuid())
  agentId   String
  action    String
  status    String
  reason    String?
  details   String?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  agent     AIAgent  @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId])
  @@index([createdAt])
  @@index([action])
}

model Wallet {
  id             String              @id @default(cuid())
  userId         String              @unique
  balance        Decimal             @default(0) @db.Decimal(10, 2)
  currency       String              @default("USD")
  totalDeposited Decimal             @default(0) @db.Decimal(10, 2)
  totalWithdrawn Decimal             @default(0) @db.Decimal(10, 2)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions   WalletTransaction[]
}

model WalletTransaction {
  id          String            @id @default(cuid())
  walletId    String
  type        TransactionType
  amount      Decimal           @db.Decimal(10, 2)
  status      TransactionStatus @default(PENDING)
  currency    String            @default("USD")
  reference   String?
  description String?
  gateway     PaymentGateway?
  gatewayTxId String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  wallet      Wallet            @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId])
  @@index([type])
  @@index([status])
  @@index([createdAt])
}

model PlatformFee {
  id          String   @id @default(cuid())
  feeType     FeeType  @unique
  amount      Decimal  @db.Decimal(10, 2)
  currency    String   @default("USD")
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model WithdrawalRequest {
  id              String           @id @default(cuid())
  userId          String
  amount          Decimal          @db.Decimal(10, 2)
  currency        String           @default("USD")
  gateway         PaymentGateway
  gatewayDetails  Json?
  status          WithdrawalStatus @default(PENDING)
  reviewedByAdmin String?
  reviewedAt      DateTime?
  reviewNotes     String?
  gatewayTxId     String?
  completedAt     DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model SystemSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       Json
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([key])
}

model VerificationCountry {
  id        String   @id @default(cuid())
  name      String
  nameZh    String?
  isEnabled Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
  @@index([isEnabled])
}

model VerificationRequest {
  id              String             @id @default(cuid())
  userId          String
  listingId       String?
  shippingCountry String
  detailedAddress String
  status          VerificationStatus @default(PENDING)
  feeAmount       Decimal?           @db.Decimal(10, 2)
  feeCurrency     String             @default("USD")
  notes           String?
  reviewedBy      String?
  reviewedAt      DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  listing         AuctionListing?    @relation(fields: [listingId], references: [id], onDelete: Cascade)
  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([listingId])
  @@index([status])
}

